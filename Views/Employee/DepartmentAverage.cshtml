@{
}
@model IEnumerable<Practice1.Models.Employee>
<h1>Department Average Salaries</h1>

<table class="table border">
    <thead>
        <tr>
            <th>Department</th>
            <th>Average Salary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Department</td>
                <td>@item.Salary</td>
            </tr>
        }
    </tbody>
</table>