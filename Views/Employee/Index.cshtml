@{
}
@model IEnumerable<Practice1.Models.Employee>

<h1>Employee List</h1>


@if(Model.Any()){

    <table class="table border">
        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Salary</th>
                <th>Experience Years</th>
                <th>Join Date</th>
                <th>Badge</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.EmpName</td>
                    <td>@employee.Department</td>
                    @if (employee.Salary > 50000)
                    {
                        <td style="color:green">@employee.Salary</td>
                    }
                    else
                    {
                        <td style="color:red">@employee.Salary</td>
                    }

                    <td>@employee.ExprienceYears</td>
                    <td>@employee.JoinDate.ToShortDateString()</td>
                    @if (employee.ExprienceYears > 5)
                    {
                        <td><span class="badge bg-success">Senior</span></td>
                    }
                    else
                    {
                        <td><span class="badge bg-warning">Junior</span></td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

else
{
    <p>No employees found.</p>
}   